# Static analysis needs the Magento classes on the autoloader, so this is only
# runnable where `composer install` has resolved magento/framework. The CI job
# that runs it is gated on those credentials being present rather than being
# allowed to pass vacuously.
parameters:
    level: 6
    # Registers the on-demand generator, so a Factory that only exists
    # after `setup:di:compile` resolves here too.
    bootstrapFiles:
        - Test/generated-classes.php
    paths:
        - Api
        - Console
        - Controller
        - Cron
        - Model
        - ViewModel
    excludePaths:
        - Test/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # __() returns a Phrase, and Magento's own controllers hand one to these
        # APIs; the parameters are documented as string and never were.
        - '#of method Magento\\Framework\\Message\\ManagerInterface::add\w+Message\(\) expects string, Magento\\Framework\\Phrase given#'
        - '#of method Magento\\Framework\\View\\Page\\Title::(set|prepend)\(\) expects string, Magento\\Framework\\Phrase given#'
        # `Acknowledge` is handed a request it deliberately never reads: the
        # page must not become an oracle for which alert ids exist, so the
        # signature is checked on the action that changes state instead. The
        # dependency going unread is the behaviour under test -
        # `testItReadsNothingFromTheRequestAndSoCannotLeakWhatExists` records
        # every param read and asserts the list is empty. Removing the
        # dependency to satisfy this rule would delete what that test asserts
        # against.
        - '#Property Commerce\\ImportMonitor\\Controller\\Alerts\\Acknowledge::\$request is never read, only written\.#'
